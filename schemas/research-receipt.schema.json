{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alvearium.net/schemas/research-receipt.schema.json",
  "title": "Alvearium Commons Research Receipt",
  "description": "A provenance record for a research run. A receipt does not establish scientific validity or independent replication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "created_at",
    "experiment",
    "artifacts",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "tool",
        "method"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardware": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Researcher-provided statements; not independently verified by receipt generation.",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "description": "Reserved for future independent verification records. Empty means no verification is recorded.",
      "items": {
        "type": "object"
      }
    }
  }
}
